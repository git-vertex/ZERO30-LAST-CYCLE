rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Профиль игрока: читает и пишет только сам игрок. Гости (анонимный вход) профиль не сохраняют.
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['login', 'bestRound', 'bestKills', 'totalRuns', 'totalKills', 'pvpWins', 'pvpMatches', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    // Всё остальное закрыто
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
